# Database Connection (MongoDB Replica Set / Atlas or Local)
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net/dbname?retryWrites=true&w=majority"

# NextAuth Authentication
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-hex-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Provider (Optional for social login)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Google Gemini AI API Configuration
GOOGLE_AI_API_KEY="AIzaSy-your-google-gemini-api-key"
# Optional comma-separated multiple keys for load balancing & quota rotation
# GOOGLE_AI_API_KEYS="key1,key2,key3"

# Cloudinary Storage Configuration (for direct PDF and avatar uploads)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Email Verification (SMTP / Nodemailer)
EMAIL_USER="noreply@example.com"
EMAIL_PASSWORD="your-email-app-password-or-private-key"
GOOGLE_REFRESH_TOKEN=""

# Upstash Redis (Rate Limiting, SSE Pub/Sub & Caching)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Application Environment
NODE_ENV="development"
